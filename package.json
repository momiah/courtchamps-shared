{
  "name": "courtchamps-shared",
  "version": "0.1.0",
  "description": "Shared types, domain constants, and helper functions for the Court Champs apps.",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momiah/courtchamps-shared.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js",
      "require": "./dist/helpers/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
